# GenomeChat Platform Backend - Environment Variables
# Copy this file to .env and fill in your actual values
# 
# Required fields are marked with (Required)
# Optional fields have sensible defaults or are commented out

# ============================================================================
# Portkey LLM Gateway Configuration (Required)
# ============================================================================

# Portkey Base URL — your gateway's OpenAI-compatible endpoint (Required)
PORTKEY_BASE_URL=https://your-gateway.example.com/v1

# Azure Provider (Required - primary provider)
PORTKEY_AZURE_API_KEY=your_portkey_azure_api_key_here
PORTKEY_AZURE_SLUG=your_portkey_azure_slug_here

# Bedrock Provider (Optional - only if using AWS Bedrock)
# PORTKEY_BEDROCK_API_KEY=your_portkey_bedrock_api_key_here
# PORTKEY_BEDROCK_SLUG=your_portkey_bedrock_slug_here

# GCP Provider (Optional - only if using Google Cloud)
# PORTKEY_GCP_API_KEY=your_portkey_gcp_api_key_here
# PORTKEY_GCP_SLUG=your_portkey_gcp_slug_here

# ============================================================================
# JWT Authentication (Required)
# ============================================================================

# Secret key for JWT token signing (Required)
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token expiration in minutes (default: 30)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days (default: 7)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Application Configuration
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Log Level: debug, info, warning, error
LOG_LEVEL=info

# API Version
API_VERSION=1.0.0

# ============================================================================
# LLM Configuration
# ============================================================================

# LLM Provider (default: portkey_azure)
LLM_PROVIDER=portkey_azure

# LLM Model to use (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# LLM Temperature (0.0 - 2.0, default: 0.7)
LLM_TEMPERATURE=0.7

# Enable LLM Streaming (true/false, default: true)
LLM_STREAMING=true

# ============================================================================
# SQL Agent Configuration
# ============================================================================

# SQL Agent mode: agentic, graph (default: agentic)
SQL_AGENT_MODE=agentic

# Human-in-the-loop for SQL queries (default: true)
SQL_HITL_ENABLED=true

# Force save all SQL query results to S3 (default: true)
SQL_ALWAYS_SAVE_TO_S3=true

# ============================================================================
# CORS Configuration
# ============================================================================

# Comma-separated list of allowed CORS origins
# Default includes localhost for development
CORS_ORIGINS=http://localhost:3100,http://localhost:5173,http://localhost:80

# ============================================================================
# Sandbox Configuration
# ============================================================================

# Sandbox URL for code execution (default: http://sandbox:8080)
SANDBOX_URL=http://sandbox:8080

# Sandbox request timeout in seconds (1-120, default: 60)
SANDBOX_TIMEOUT=60

# R Sandbox URL for R code execution (default: http://r-sandbox:8081)
R_SANDBOX_URL=http://localhost:8081

# R Sandbox request timeout in seconds (1-120, default: 60)
R_SANDBOX_TIMEOUT=60

# ============================================================================
# AWS S3 Configuration
# ============================================================================

# AWS Access Key ID (optional - if not set, uses IAM role/default credentials)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here

# AWS Secret Access Key (optional - if not set, uses IAM role/default credentials)
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS Session Token (optional - for temporary credentials)
# AWS_SESSION_TOKEN=your_aws_session_token_here

# AWS Default Region (default: us-east-1)
AWS_DEFAULT_REGION=us-east-1

# Default S3 Bucket Name (optional - convenience setting)
AWS_DEFAULT_BUCKET=your_default_bucket_name_here

# Allowed S3 Buckets (optional - comma-separated whitelist)
# If not set, all buckets are allowed (subject to IAM permissions)
# ALLOWED_S3_BUCKETS=bucket1,bucket2,bucket3

# ============================================================================
# MongoDB Configuration
# ============================================================================

# MongoDB connection string (Required for production)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017

# MongoDB database name for checkpoints and data
MONGODB_DB_NAME=genome_chat

# ============================================================================
# LangGraph Checkpointer Configuration
# ============================================================================

# Checkpointer type: mongodb (production), sqlite (testing)
CHECKPOINTER_TYPE=mongodb

# SQLite checkpointer path (only used when CHECKPOINTER_TYPE=sqlite)
CHECKPOINTER_DB_PATH=databases/checkpoints.db

# ============================================================================
# SSL Configuration
# ============================================================================

# CA bundle path — only needed behind a TLS-intercepting corporate proxy.
# Leave unset on a direct internet connection.
SSL_CERT_PATH=path/to/ca-bundle.crt

# Disable SSL verification (development only - NEVER in production)
DISABLE_SSL_VERIFY=true

# ============================================================================
# Database Configuration -- Genomics
# ============================================================================
#
# Legacy single-database settings. The registry below is the primary
# mechanism; these remain for the non-registry code paths.

# Database Type: sqlite, duckdb, postgres, mysql, mssql, athena
DATABASE_TYPE=sqlite

# SQLite file path (when DATABASE_TYPE=sqlite)
SQLITE_PATH=databases/clinvar/clinvar.db

# Database schema description file
DATABASE_SCHEMA_PATH=databases/clinvar/schema_description.yaml

# Database name (for non-SQLite databases)
# DATABASE_NAME=your_database_name

# Database connection settings (for non-SQLite databases)
# HOST=localhost
# PORT=5432
# USERNAME=your_username
# PASSWORD=your_password

# ============================================================================
# Database Registry (Multi-Database Support)
# ============================================================================
#
# Three genomics profiles ship by default:
#
#   clinvar  NCBI ClinVar variant/condition assertions.  SQLite, built
#            locally.  Public domain.
#   gwas     NHGRI-EBI GWAS Catalog associations + studies.  Parquet via
#            DuckDB, built locally.  CC BY 4.0.
#   ensembl  Ensembl human core annotation.  Queried live over the public
#            read-only MySQL mirror; nothing stored locally.
#
# Build the two local ones first:
#   uv run python scripts/build_genomics_databases.py --download

# Active database profile: clinvar, gwas, ensembl
DB_REGISTRY_ACTIVE_DATABASE=clinvar

# Application root directory (optional - defaults to current working directory)
# Useful for Docker/Kubernetes deployments where paths are mounted differently
# APP_ROOT=/app

# === Data Path Overrides (for Docker/Kubernetes deployments) ===
# Override the default data paths for each database profile
# DB_REGISTRY_CLINVAR_DATA_PATH_OVERRIDE=/data/clinvar/clinvar.db
# DB_REGISTRY_GWAS_DATA_PATH_OVERRIDE=/data/gwas

# S3 path for the GWAS Parquet files (takes priority over the local path).
# DuckDB reads these directly via the httpfs extension.
# DB_REGISTRY_GWAS_S3_PATH=s3://your-bucket/gwas/

# === Ensembl public MySQL mirror ===
# OFF BY DEFAULT. The EBI public server allows anonymous read-only access, but
# it speaks MySQL protocol on port 3306 and many corporate networks block that
# at the application layer — the TCP handshake succeeds and then the MySQL
# handshake is cut ("Lost connection at reading initial communication packet").
# Confirm with a real client before switching this on:
#   mysql -h ensembldb.ensembl.org -u anonymous -e "SELECT VERSION()"
# DB_REGISTRY_ENSEMBL_ENABLED=true
# DB_REGISTRY_ENSEMBL_HOST=ensembldb.ensembl.org
# DB_REGISTRY_ENSEMBL_PORT=3306
# DB_REGISTRY_ENSEMBL_USERNAME=anonymous
# DB_REGISTRY_ENSEMBL_PASSWORD=
#
# The database name carries the Ensembl release number. When the mirror
# retires a release, connections fail — list what is available with
#   mysql -h ensembldb.ensembl.org -u anonymous -e "SHOW DATABASES LIKE 'homo_sapiens_core%'"
# and set the newest here.
# DB_REGISTRY_ENSEMBL_DATABASE=homo_sapiens_core_115_38
#
# Comma-separated table whitelist; overrides the profile default. The core
# schema has ~75 tables and exposing all of them floods the agent context.
# DB_REGISTRY_ENSEMBL_ALLOWED_TABLES=gene,transcript,translation,exon,exon_transcript,seq_region,coord_system,xref,object_xref,external_db,external_synonym,analysis,assembly,karyotype,meta

# === Schema Path Overrides (usually not needed - schemas bundled with app) ===
# Only use if schema files are mounted separately from the application
# DB_REGISTRY_CLINVAR_SCHEMA_PATH_OVERRIDE=/config/clinvar/schema_description.yaml
# DB_REGISTRY_GWAS_SCHEMA_PATH_OVERRIDE=/config/gwas/schema_description.yaml
# DB_REGISTRY_ENSEMBL_SCHEMA_PATH_OVERRIDE=/config/ensembl/schema_description.yaml

# ============================================================================
# Observability — OpenTelemetry & Traces (Phase 0)
# ============================================================================
#
# Two related switches: OTEL_ENABLED controls whether spans are EMITTED at
# all (in-process), TRACE_STORAGE_ENABLED controls whether emitted spans
# are WRITTEN to the MongoDB `traces` collection. Most development setups
# want BOTH set to true so /internal/traces works and agent.backend=sdk
# can be verified after a chat turn. Production defaults to both-off until
# the observability pipeline is formally enabled.

# Enable OpenTelemetry span export (default: false)
# OTEL_ENABLED=true

# OTel service.name resource attribute (default: genomechat-backend)
# OTEL_SERVICE_NAME=genomechat-backend

# Write spans to MongoDB `traces` collection (default: false)
# Requires OTEL_ENABLED=true to have anything to write.
# TRACE_STORAGE_ENABLED=true

# MongoDB collection for spans (default: traces)
# TRACE_MONGODB_COLLECTION=traces

# Daily mirror of the traces collection to S3 (default: false)
# TRACE_S3_ARCHIVE_ENABLED=false

# S3 prefix for the archive (default: traces/)
# TRACE_S3_PREFIX=traces/

# Span sampling rate, 0.0–1.0 (default: 1.0 = capture everything)
# TRACE_SAMPLING_RATE=1.0

# MongoDB TTL for the traces collection in days, 7–730 (default: 90)
# TRACE_TTL_DAYS=90

# ============================================================================
# Langfuse Forward-Compat (Phase 0 default OFF; Phase 2 decision gate)
# ============================================================================
#
# Multi-exporter plumbing ships in Phase 0 so Langfuse can be turned on
# later without re-instrumenting. Leave OFF unless you have a running
# Langfuse instance. See docs/backend/phase0_observability_guide.md.

# Also export spans to a Langfuse OTLP endpoint (default: false)
# LANGFUSE_ENABLED=false

# Langfuse OTLP HTTP endpoint — must include the /api/public/otel/v1/traces path.
# - Local self-hosted from inside a container: http://host.containers.internal:3000/api/public/otel/v1/traces
#   (containers can't reach the host's localhost; host.containers.internal is Podman's host-gateway alias,
#   equivalent to host.docker.internal on Docker Desktop.)
# - Deployed: https://langfuse.internal/api/public/otel/v1/traces
# LANGFUSE_OTLP_ENDPOINT=

# Base64("public_key:secret_key") for Langfuse Basic auth — NOT the keys directly.
# Generate with:  echo -n "pk-lf-xxx:sk-lf-xxx" | base64
# LANGFUSE_AUTH_HEADER=

# Attach node/tool/LLM inputs and outputs to spans so Langfuse's Input/Output
# columns are populated. DEV-ONLY: payloads can be large and may contain
# sensitive data. Default off; do not enable in prod without a review.
# TRACE_CAPTURE_PAYLOADS=false

# Per-attribute payload char cap (500–100000, default: 8000). Longer values
# are truncated with a "…[truncated N chars]" suffix.
# TRACE_PAYLOAD_MAX_CHARS=8000

# ============================================================================
# Internal Observability Endpoints Access Control
# ============================================================================
#
# The /internal/traces, /internal/memory, and /internal/health/agent-backends
# routes are mounted when this flag is on. Tenant/project scoping and audit
# logging are enforced per PRD §11 regardless of this flag.

# Expose /internal/* observability routes (default: true)
# INTERNAL_OBSERVABILITY_ENABLED=true

# Per-caller rate limit for /internal/* endpoints (default: 1000/hour)
# INTERNAL_OBSERVABILITY_RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# Memory Pipeline (Phase 0.5 — pilot-gated, default OFF)
# ============================================================================
#
# Per-turn memory extraction + scheduled consolidation + 5-layer retrieval.
# Pilot-gated via MEMORY_PILOT_USER_IDS; all flags default OFF and must stay
# OFF until the governance work in PRD §13 (consent, redaction, retention,
# hard-delete) is complete. See docs/backend/phase0_5_memory_governance.md.

# Enable per-turn memory extraction (default: false)
# MEMORY_EXTRACTION_ENABLED=false

# Fraction of turns to extract, 0.0–1.0 (default: 0.2)
# MEMORY_EXTRACTION_SAMPLING_RATE=0.2

# Agent key for the extraction LLM (default: summarizer = Haiku via Portkey Bedrock)
# MEMORY_EXTRACTION_AGENT=summarizer

# Comma-separated opt-in user IDs eligible for memory extraction
# MEMORY_PILOT_USER_IDS=

# Max concurrent extraction tasks per user (default: 2)
# MEMORY_EXTRACTION_PER_USER_CONCURRENCY=2

# Enable scheduled consolidation job (default: false)
# MEMORY_CONSOLIDATION_ENABLED=false

# Consolidation cadence in minutes, 5–1440 (default: 30)
# MEMORY_CONSOLIDATION_INTERVAL_MINUTES=30

# Embedding provider: portkey-bedrock-titan | portkey-gcp-gemini
# MEMORY_EMBEDDING_PROVIDER=portkey-bedrock-titan

# Embedding model identifier (default: amazon.titan-embed-text-v2:0)
# MEMORY_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Embedding dimensionality — Titan V2 supports 256/512/1024 (default: 1024)
# MEMORY_EMBEDDING_DIMENSIONS=1024

# Concurrent Portkey Bedrock embedding requests per instance (default: 8)
# MEMORY_EMBEDDING_CONCURRENCY=8

# Cosine threshold above which new memories are treated as duplicates (default: 0.85)
# MEMORY_DUPLICATE_THRESHOLD=0.85

# Use Atlas $vectorSearch; set false to fall back to brute-force cosine (default: true)
# Requires an Atlas Vector Search index on research_memories; see
# docs/backend/phase0_5_memory_governance.md for the index definition.
# MEMORY_ATLAS_VECTOR_SEARCH_ENABLED=true

# MongoDB TTL for research_memories in days, 30–1095; pinned memories exempt (default: 180)
# MEMORY_TTL_DAYS=180

# ============================================================================
# Agent Backend Feature Flags (Phase 0 / Phase 1)
# ============================================================================
#
# Per-agent backend selection. Each worker-class agent can run through either
# the LangChain factory or the Claude Agent SDK. Default is LangChain on all
# agents; Phase 1 enables the SDK path for the coder.
# Resolver: src/config/agent_backends.py

# Coder worker backend: langchain | sdk (default: langchain)
# Set to 'sdk' to route coder through claude-agent-sdk via Portkey Bedrock.
# See docs/backend/phase1_sdk_coder_operator_guide.md for enable/rollback.
# CODER_BACKEND=langchain

# Orchestrator backend: langchain | sdk (default: langchain)
# Phase 2 Workstream B adds SDK support behind a prototype — never merged
# into production default during Phase 2. Override per-request via
# ChatRequest.orchestrator_backend or system-wide via this env flag.
# See docs/backend/phase2_operator_guide.md for enable/rollback.
# ORCHESTRATOR_BACKEND=langchain

# ============================================================================
# Claude Agent SDK Runtime (Phase 1 — only used when CODER_BACKEND=sdk)
# ============================================================================
#
# These settings have safe defaults and never need to be set in development.
# Production deployments may want to tune orphan-cleanup cadence.

# Anchor root for per-request transcript directories (default: /tmp/genomechat-sdk)
# NOTE: the SDK actually writes transcript JSONLs to ~/.claude/projects/<project_key>/
# — this root is only a namespace anchor per request. See
# docs/backend/phase1_sdk_coder_operator_guide.md §4 for background.
# SDK_TRANSCRIPT_ROOT=/tmp/genomechat-sdk

# Max age (seconds) before a stale transcript directory is swept (default: 3600)
# SDK_ORPHAN_CLEANUP_MAX_AGE_SECONDS=3600

# Periodic orphan-sweep cadence in minutes (default: 30)
# SDK_ORPHAN_CLEANUP_INTERVAL_MINUTES=30

# Max tool-use turns per coder query() call (default: 20)
# CODER_SDK_MAX_TURNS=20

# SDK permission mode — production MUST be bypassPermissions (default: bypassPermissions)
# CODER_SDK_PERMISSION_MODE=bypassPermissions

# Bedrock-flavored model ID for the SDK coder (default: us.anthropic.claude-sonnet-4-6)
# Portkey rejects short aliases like "claude-sonnet-4-6" — use the full Bedrock form.
# CODER_SDK_MODEL=us.anthropic.claude-sonnet-4-6

# Container / pod identifier for transcript isolation across multi-replica
# deployments. Resolution order: INSTANCE_ID -> POD_NAME -> HOSTNAME ->
# local-<uuid4>. K8s deployments usually set POD_NAME via downward API;
# Docker/Podman set HOSTNAME automatically. Override only for debugging.
# INSTANCE_ID=my-backend-pod-1

# ============================================================================
# Claude Agent SDK Orchestrator (Phase 2 Workstream B — prototype)
# ============================================================================
#
# Only used when ORCHESTRATOR_BACKEND=sdk OR a request sets
# ChatRequest.orchestrator_backend='sdk'. Ignored on the LangChain path.

# Bedrock-flavored model ID for the SDK orchestrator (default:
# us.anthropic.claude-sonnet-4-6 — same as coder so evaluation compares
# architecture, not model choice).
# ORCHESTRATOR_SDK_MODEL=us.anthropic.claude-sonnet-4-6

# Max tool-use turns per orchestrator query() call (default: 30, higher
# than the coder's 20 because the orchestrator drives multi-worker plans).
# ORCHESTRATOR_SDK_MAX_TURNS=30

# Tool-exposure mode: delegated | flat (default: delegated, recommended)
#
# 'delegated' — orchestrator has NO direct MCP tools; can only call
#   TodoWrite + AgentDefinition sub-agents (coder / sql_agent).
#   All tool calls happen inside a sub-agent's isolated conversation.
#   Better context economy + honest A/B comparison with the LangChain
#   orchestrator's delegation contract. Use this for evaluation.
#
# 'flat' — orchestrator sees all 14 MCP tools AND sub-agents. Sonnet
#   typically picks direct calls on simple queries; faster per-turn but
#   orchestrator context grows with every tool result. Useful as a
#   supplementary data point.
#
# Invalid values fall back to 'delegated' with a warning.
# ORCHESTRATOR_SDK_TOOL_MODE=delegated

# ============================================================================
# Evaluation Harness (Phase 0.5 — trajectory capture)
# ============================================================================

# Comma-separated opt-in user IDs eligible for trajectory capture.
# Required for `python -m evaluation.cli bootstrap` to produce a dataset.
# Pilot-gated: empty by default, populated only after consent governance work.
# EVAL_CONSENTED_USER_IDS=

# ============================================================================
# Vault Secrets (Optional - for production deployment)
# ============================================================================

# Set to true to enable loading secrets from /secrets/secret.yaml
# USE_VAULT_SECRETS=false