# GenomeChat Platform Frontend - Environment Variables
# Copy this file to .env and fill in your actual values
#
# Note: All Vite environment variables must be prefixed with VITE_
# These are baked into the build at compile time

# ============================================================================
# API Configuration
# ============================================================================

# Backend API URL (Required)
# For local development: http://localhost:8000
# For Docker compose: http://backend:8000
# For production: https://your-backend-host.example.com (no trailing slash)
VITE_API_URL=http://localhost:8000

# ============================================================================
# Vault Secrets (Optional - for production deployment)
# ============================================================================
# 
# When deploying to Kubernetes with Vault Secrets, the inject-config.js script
# will read from /secrets/secret.yaml and inject API_URL or VITE_API_URL
# at container startup, overriding the build-time value.
#
# Set to true to enable runtime config injection
# USE_VAULT_SECRETS=false
